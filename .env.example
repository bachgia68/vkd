# Sao chép file này thành .env (chỉ dùng cho máy local, KHÔNG commit .env thật lên git).
# Trên Netlify: Site settings → Environment variables → thêm 3 biến dưới đây với giá trị thật
# lấy từ https://my.payos.vn → Kênh thanh toán → Thông tin kết nối.

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Email báo đơn hàng mới (khi khách thanh toán PayOS thành công).
# Lấy RESEND_API_KEY tại https://resend.com (miễn phí, không cần domain riêng — dùng sender
# mặc định onboarding@resend.dev là gửi được ngay).
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=mcmpro6688@gmail.com

# Supabase credentials (from https://app.supabase.com/project/xcwirgrlnibnjmseglee/settings/api)
# These are public anon key — safe to commit in .env.example (already in .env).
# Dùng cho đăng nhập admin (AdminAuthContext.tsx) VÀ tra cứu điểm loyalty phía khách hàng
# (src/lib/loyaltyService.ts). Anon key chỉ đọc được dữ liệu qua các RPC function được
# cấp quyền tường minh (xem docs/superpowers/SUPABASE_SCHEMA.md) — không đọc thẳng bảng.
VITE_SUPABASE_URL=https://xcwirgrlnibnjmseglee.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
